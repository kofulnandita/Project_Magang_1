---
export interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
}
const { title, description, tags, href } = Astro.props;
---

<a href={href} class="project-card">
  <div class="project-card__content">
    <div class="project-card__tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__desc">{description}</p>
    <div class="project-card__footer">
      <span class="project-card__view">
        Lihat Studi Kasus
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </span>
    </div>
  </div>
  <div class="project-card__arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    text-decoration: none;
    color: inherit;
    padding: 32px;
    background: rgba(13, 20, 38, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    margin-bottom: 20px;
    backdrop-filter: blur(12px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }
  .project-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: transparent;
    transition: background 0.3s ease;
  }
  .project-card:hover {
    background: rgba(18, 28, 54, 0.85);
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -10px rgba(0, 210, 255, 0.2);
  }
  .project-card:hover::before {
    background: linear-gradient(180deg, var(--accent-cyan), var(--accent-blue));
  }

  .project-card__content {
    flex: 1;
  }
  .project-card__tags {
    margin-bottom: 12px;
  }
  .project-card__title {
    font-size: 1.45rem;
    margin: 0 0 8px;
    color: #ffffff;
    transition: color 0.2s ease;
  }
  .project-card:hover .project-card__title {
    color: var(--accent-cyan);
  }
  .project-card__desc {
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.6;
    max-width: 68ch;
    margin: 0 0 16px;
  }
  .project-card__footer {
    display: flex;
    align-items: center;
  }
  .project-card__view {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-cyan);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  .project-card:hover .project-card__view {
    opacity: 1;
  }

  .project-card__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }
  .project-card:hover .project-card__arrow {
    background: var(--accent-cyan);
    color: #060911;
    border-color: var(--accent-cyan);
    transform: rotate(45deg);
    box-shadow: 0 0 15px rgba(0, 210, 255, 0.5);
  }

  @media (max-width: 640px) {
    .project-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
      gap: 20px;
    }
    .project-card__arrow {
      align-self: flex-end;
    }
  }
</style>
