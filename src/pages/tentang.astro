---
import Layout from "../layouts/Layout.astro";

// ============================================================================
// DATA ANGGOTA TIM & NILAI KERJA (Bisa Anda edit langsung di sini)
// ============================================================================
const teamMembers = [
  {
    initials: "Z",
    name: "Muhammad Dzaki Devsi Pratama", // 
    role:  "Konten, Ai Automation & Git",
    specialty: "Ai Automation & Git",
    bio: "Bertugas sebagai Pencetak karya dan koordinasi Ai Automation."
  },
  {
    initials: "G",
    name: "Abdul Ghofur", // 
    role: "Frontend,Arsitektur Website",
    specialty: "Frontend & Git",
    bio: "Bertugas Menjadi Frontend Website dan Koordinasi Git ."
  }
];

const values = [
  {
    title: "Jelas & Bertujuan",
    desc: "Dalam mengerjakan project setiap keputusan yang kami berikan harus jelas serta memiliki tujuan yang berdampak baik."
  },
  {
    title: "Rapi & Terstandar",
    desc: "merupakan standar kami dalam mengerjakan project sehingga hasil yang kami berikan baik dan profesional."
  },
  {
    title: "Jujur & Transparan",
    desc: "Kami hanya menampilkan apa yang benar-benar kami kuasai dan kerjakan. Kredibilitas dan kepercayaan menjadi dasar kami dalam membuat karya."
  }
];
---

<Layout title="Tentang">

  <!-- ===================================================================== -->
  <!-- BAGIAN 1: HEADER & CERITA STUDIO                                      -->
  <!-- ===================================================================== -->
  <section class="section section--tight">
    <div class="container">
      
      <div class="badge-pill">
        <span>&lt;/&gt;</span>
        <span>PROFIL & DEDIKASI TIM</span>
      </div>

      <h1>
        Tentang Studio 
        <br />
        <em>Larik</em>
      </h1>

      <p class="lede">
        Larik dimulai dari tugas kami selama program magang. Alih-alih membuat
        portofolio individu yang terpisah, kami ditugaskan untuk membangunnya sebagai satu
        "studio digital" bersama — agar setiap proyek yang kami teliti dan bangun
        memiliki wadah terpadu dengan kualitas terbaik.
      </p>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BAGIAN 2: DAFTAR ANGGOTA TIM                                          -->
  <!-- ===================================================================== -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      
      <div class="section__header" style="margin-bottom: 32px;">
        <div>
          <span class="section__eyebrow">KOLABORASI DUA DISIPLIN</span>
          <h2>
            Dua Orang, 
            <em>Satu Visi Kualitas</em>
          </h2>
        </div>
      </div>

      <div class="team-grid">
        {teamMembers.map((member) => (
          <div class="glass-card team-card">
            
            <div class="team-card__top">
              <div class="team-card__avatar">
                {member.initials}
              </div>
              <div class="team-card__meta">
                <h3 class="team-card__name">
                  {member.name}
                </h3>
                <p class="team-card__role">
                  {member.role}
                </p>
              </div>
            </div>
            
            <p class="team-card__bio">
              {member.bio}
            </p>

            <div class="team-card__skills">
              <span class="skills-label">
                Fokus Utama:
              </span>
              <p class="skills-text">
                {member.specialty}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BAGIAN 3: NILAI & CARA KAMI BEKERJA                                   -->
  <!-- ===================================================================== -->
  <section class="section section--darker">
    <div class="container">
      
      <div class="section__header">
        <div>
          <span class="section__eyebrow">PRINSIP & NILAI</span>
          <h2>
            Cara Kami 
            <em>Bekerja & Mengeksekusi</em>
          </h2>
        </div>
      </div>

      <div class="values-grid">
        {values.map((v) => (
          <div class="glass-card value-card">
            
            <div class="value-card__icon">
              <svg 
                width="24" 
                height="24" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>

            <h3>
              {v.title}
            </h3>

            <p>
              {v.desc}
            </p>

          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>

<style>
  .section__header {
    margin-bottom: 40px;
  }

  .section__eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-cyan);
    margin-bottom: 10px;
  }

  /* Team Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .team-card {
    padding: 36px;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .team-card__top {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .team-card__avatar {
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(0, 210, 255, 0.25), rgba(59, 130, 246, 0.3));
    border: 1px solid rgba(0, 210, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-cyan);
    box-shadow: 0 0 20px rgba(0, 210, 255, 0.2);
    flex-shrink: 0;
  }

  .team-card__name {
    font-size: 1.5rem;
    margin: 0 0 4px;
    color: #ffffff;
  }

  .team-card__role {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent-cyan);
    margin: 0;
  }

  .team-card__bio {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .team-card__skills {
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }

  .skills-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    display: block;
    margin-bottom: 4px;
  }

  .skills-text {
    font-size: 0.88rem;
    color: var(--text-main);
    margin: 0;
  }

  /* Values Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .value-card {
    padding: 32px;
  }

  .value-card__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0, 210, 255, 0.08);
    border: 1px solid rgba(0, 210, 255, 0.25);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .value-card h3 {
    margin: 0 0 12px;
  }

  .value-card p {
    font-size: 0.93rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 840px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
